# ====================================================
# LOAN MANAGEMENT SYSTEM ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting the server.
# NEVER commit real passwords, keys, or secrets to Git.
# ====================================================

# MySQL Database Credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=loan_dashboard
DB_PORT=3306

# Node Server Configuration
PORT=5000
NODE_ENV=development

# Optional: SQLite Database Engine Fallback
# Set to 'sqlite' to force offline embedded SQLite mode
# DB_ENGINE=mysql

